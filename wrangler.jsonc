// Postavke za Cloudflare Workers (deploy komanda: npx wrangler deploy).
// Ime mora odgovarati imenu Workera u Cloudflare dashboardu.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prodajni-panel",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Ove putanje prvo obrađuje Worker (prijava, panel, administracija, stranica za klijente);
    // slike i ostale statične datoteke se služe direktno.
    "run_worker_first": ["/", "/panel", "/panel/", "/prijava", "/prijava/", "/odjava", "/odjava/", "/admin", "/admin/", "/app-shell*"]
  },
  // KV prostor "prodajni-panel-sarajka" za linkove za klijente i korisnike.
  "kv_namespaces": [
    { "binding": "SARAJKA", "id": "51fc2458d4d44fcf94c97c9ee04ac988" }
  ],
  // Varijable (PUBLIC_URL, SESSION_SECRET) postavljaju se u dashboardu i ne brišu se pri deployu.
  "keep_vars": true,
  "observability": { "enabled": true }
}
